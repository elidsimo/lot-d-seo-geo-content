# Adaptateur LLM (Google Gemini - cle gratuite sur https://aistudio.google.com/)
LLM_PROVIDER_API_KEY=your_gemini_api_key_here
LLM_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_PROVIDER_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER_EMBEDDING_MODEL=gemini-embedding-001

# Lot A (formats provisoires - a confirmer avec le Lot A)
LOT_A_HISTORY_ENDPOINT=http://localhost:3001/history
LOT_A_BRAND_PARAMETERS_ENDPOINT=http://localhost:3001/brand-parameters
LOT_A_CLIENT_CONFIG_ENDPOINT=http://localhost:3001/client-config

# Mode simulation (true tant que le Lot A n'expose pas encore ses endpoints)
MOCK_MODE=true

# Base de donnees RAG (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/postgres

# Port du serveur (optionnel, 3000 par defaut)
PORT=3000